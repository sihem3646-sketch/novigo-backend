# .env.example — copie en .env (ne jamais committer .env)
# Ces valeurs restent CÔTÉ SERVEUR uniquement.

# --- Voix (ElevenLabs) ---
# Clé secrète ElevenLabs (https://elevenlabs.io -> Profile -> API Key)
ELEVENLABS_API_KEY=

# ID d'une voix jeune/ado française (ElevenLabs -> Voice Library -> copier le Voice ID)
ELEVENLABS_VOICE_ID=

# Modèle multilingue (parle français)
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Coach Nova (Mistral) ---
# Clé API Mistral (https://console.mistral.ai -> API Keys)
MISTRAL_API_KEY=

# --- Sécurité des routes /api/nova ---
# Secret JWT du projet Supabase (Dashboard -> Settings -> API -> JWT Secret).
# Sert à vérifier le token de l'utilisateur : le userId de confiance = token.sub.
# Si absent, les routes /api/nova sont fermées (401).
SUPABASE_JWT_SECRET=

# DEV UNIQUEMENT : identifiant d'utilisateur forcé quand aucun token n'est fourni,
# pour tester en local sans Supabase. Laisser VIDE en production.
NOVA_DEV_USER=

# Plafond de messages /api/nova par utilisateur et par jour (défaut 20).
NOVA_DAILY_LIMIT=20

PORT=8787
