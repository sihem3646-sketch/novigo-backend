# .env.example — copie en .env (ne jamais committer .env)
# Ces valeurs restent CÔTÉ SERVEUR uniquement.

# --- Voix (ElevenLabs) ---
# Clé secrète ElevenLabs (https://elevenlabs.io -> Profile -> API Key)
ELEVENLABS_API_KEY=

# ID d'une voix jeune/ado française (ElevenLabs -> Voice Library -> copier le Voice ID)
ELEVENLABS_VOICE_ID=

# Modèle multilingue (parle français)
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Coach Nova (Mistral) ---
# Clé API Mistral (https://console.mistral.ai -> API Keys)
MISTRAL_API_KEY=

# --- Supabase (annuaire + Nova) ---
# URL du projet Supabase (Dashboard -> Settings -> API -> Project URL).
SUPABASE_URL=
# Clé SERVICE ROLE (Dashboard -> Settings -> API). SECRÈTE : ne jamais l'exposer
# côté app. Sert à l'annuaire, à la mémoire et aux quotas de Nova.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sécurité des routes /api/nova ---
# Les sessions sont vérifiées avec la clé publique du projet (JWKS, ES256) : rien à
# configurer. FACULTATIF : ancien secret partagé (HS256), seulement pour un projet
# qui signe encore ses sessions avec (Dashboard -> Settings -> API -> JWT Secret).
SUPABASE_JWT_SECRET=

# --- Quotas de Nova (par COMPTE) ---
# Formule gratuite : messages par mois, et au plus par jour.
NOVA_FREE_MONTHLY_LIMIT=20
NOVA_FREE_DAILY_LIMIT=5

PORT=8787

# --- Sécurité ---
# Voix IA (route /tts) : coupée par défaut ; 1 = active (espace Enfant seulement).
TTS_ENABLED=0
# Voix autorisées en plus de ELEVENLABS_VOICE_ID (identifiants, séparés par des virgules).
ELEVENLABS_VOICE_IDS=
# Bêta « adultes d'abord » : Nova réservée aux profils Adultes (0 = lever).
BETA_ADULTS_ONLY=1
# Origines de navigateur autorisées (liste complète, sans joker). Vide = production
# connue (novigo.expo.app, mynovigo.fr, www.mynovigo.fr). En local, ajouter par ex.
# http://localhost:8081.
ALLOWED_ORIGINS=
# Nombre de relais (proxy) devant le serveur, pour lire la vraie adresse du client.
TRUST_PROXY_HOPS=
# Suppression du compte : âge maximal de la connexion par mot de passe (secondes).
ACCOUNT_REAUTH_MAX_AGE_S=300

